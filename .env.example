# Copy this file to .env and fill in your keys.

# --- AI/ML API ---
# Get a key from https://aimlapi.com/app/keys
# AI/ML API is OpenAI-compatible, so setting these two variables routes
# every agent's model calls (via Pydantic AI's "openai:" models) through
# AI/ML API -- no extra code needed.
OPENAI_API_KEY=your_aimlapi_key_here
OPENAI_BASE_URL=https://api.aimlapi.com/v1

# --- Per-agent model overrides (optional) ---
# Any AI/ML API chat model ID works here, prefixed with "openai-chat:" so
# Pydantic AI targets the Chat Completions API AI/ML API speaks.
# Leave unset to fall back to DEFAULT_MODEL.
#
# DeepSeek V3.1 (tool-calling capable) via AI/ML API:
#
# NB: plain "deepseek-chat" on AI/ML API responds with plain text instead of
# making tool calls, so agents never call `band_send_message` or `write_file`.
# Use the versioned "deepseek/deepseek-chat-v3.1" id, which calls tools correctly.
DEFAULT_MODEL=openai-chat:deepseek/deepseek-chat-v3.1
#
# OpenAI alternative:
# DEFAULT_MODEL=openai-chat:gpt-4o-mini
#
# Mix models per agent if you like -- e.g. give the Reviewer a different model:
# PLANNER_MODEL=openai-chat:deepseek/deepseek-chat-v3.1
# ENGINEER_MODEL=openai-chat:deepseek/deepseek-chat-v3.1
# REVIEWER_MODEL=openai-chat:gpt-4o-mini

# --- Band platform (optional) ---
# Only set these if you're pointed at a non-default Band environment.
# Agent.create() already defaults to the production Band platform.
# BAND_REST_URL=https://app.band.ai
# BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
